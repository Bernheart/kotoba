{
  "lesson": 4,
  "title": { "en": "The first date", "pl": "Pierwsza randka", "ja": "{初めて|はじめて}の デート" },
  "words": [
    { "id": "l01-anata", "japanese": "あなた", "kana": "あなた", "en": "you", "pl": "ty; pan/pani", "type": "pronoun", "genkiLesson": 4, "tags": ["people"],
      "example": { "ja": "*あなた*は {留学生|りゅうがくせい}ですか。", "en": "Are you an international student?", "pl": "Czy jesteś studentem z zagranicy?" } },
    { "id": "l02-hito", "japanese": "人", "kana": "ひと", "en": "person", "pl": "osoba; człowiek", "type": "noun", "genkiLesson": 4, "tags": ["people"],
      "example": { "ja": "あの *{人|ひと}*は {日本人|にほんじん}じゃないです。", "en": "That person isn't Japanese.", "pl": "Tamta osoba nie jest Japończykiem." } },
    { "id": "l02-resutoran", "japanese": "レストラン", "kana": "レストラン", "en": "restaurant", "pl": "restauracja", "type": "noun", "genkiLesson": 4, "tags": ["places", "food"],
      "example": { "ja": "あそこは {日本|にほん}の *レストラン*です。", "en": "Over there is a Japanese restaurant.", "pl": "Tam jest japońska restauracja." } },
    { "id": "l02-honya", "japanese": "本屋", "kana": "ほんや", "en": "bookstore", "pl": "księgarnia", "type": "noun", "genkiLesson": 4, "tags": ["places", "shopping"],
      "example": { "ja": "ここは {大学|だいがく}の *{本屋|ほんや}*です。", "en": "This is the university bookstore.", "pl": "To jest księgarnia uniwersytecka." } },
    { "id": "l04-aru", "japanese": "ある", "kana": "ある", "en": "to be; to exist (things, places); to have; (an event) to take place", "pl": "być; znajdować się (o rzeczach); mieć; odbywać się", "type": "verb-u", "genkiLesson": 4, "tags": ["existence"],
      "example": { "ja": "{今日|きょう}は {日本語|にほんご}の クラスが *あります*。", "en": "I have Japanese class today.", "pl": "Dzisiaj mam zajęcia z japońskiego." } },
    { "id": "l04-iru", "japanese": "いる", "kana": "いる", "en": "to be; to exist (people, animals); to stay", "pl": "być; znajdować się (o ludziach i zwierzętach); przebywać", "type": "verb-ru", "genkiLesson": 4, "tags": ["existence"],
      "example": { "ja": "{日本|にほん}に {友達|ともだち}が *います*。", "en": "I have friends in Japan.", "pl": "Mam znajomych w Japonii." } },
    { "id": "l04-ue", "japanese": "上", "kana": "うえ", "en": "on; above; top", "pl": "na; nad; góra", "type": "noun", "genkiLesson": 4, "tags": ["location"],
      "example": { "ja": "{机|つくえ}の *{上|うえ}*に {写真|しゃしん}が あります。", "en": "There's a photo on the desk.", "pl": "Na biurku jest zdjęcie." } },
    { "id": "l04-shita", "japanese": "下", "kana": "した", "en": "under; below; bottom", "pl": "pod; poniżej; dół", "type": "noun", "genkiLesson": 4, "tags": ["location"],
      "example": { "ja": "{椅子|いす}の *{下|した}*に {犬|いぬ}が います。", "en": "There's a dog under the chair.", "pl": "Pod krzesłem jest pies." } },
    { "id": "l04-mae", "japanese": "前", "kana": "まえ", "en": "in front of; front; before (in time)", "pl": "przed (w przestrzeni lub czasie); przód", "type": "noun", "genkiLesson": 4, "tags": ["location"],
      "example": { "ja": "{駅|えき}の *{前|まえ}*に {本屋|ほんや}が あります。", "en": "There's a bookstore in front of the station.", "pl": "Przed stacją jest księgarnia." } },
    { "id": "l04-ushiro", "japanese": "後ろ", "kana": "うしろ", "en": "behind; back", "pl": "za; z tyłu; tył", "type": "noun", "genkiLesson": 4, "tags": ["location"],
      "example": { "ja": "{学校|がっこう}の *{後ろ|うしろ}*に {公園|こうえん}が あります。", "en": "There's a park behind the school.", "pl": "Za szkołą jest park." } },
    { "id": "l04-naka", "japanese": "中", "kana": "なか", "en": "inside; in", "pl": "w (środku); wewnątrz; środek", "type": "noun", "genkiLesson": 4, "tags": ["location"],
      "example": { "ja": "かばんの *{中|なか}*に {財布|さいふ}が ありません。", "en": "My wallet isn't in my bag.", "pl": "W torbie nie ma portfela." } },
    { "id": "l04-tonari", "japanese": "隣", "kana": "となり", "en": "next to; next door", "pl": "obok; po sąsiedzku", "type": "noun", "genkiLesson": 4, "tags": ["location"],
      "example": { "ja": "{銀行|ぎんこう}の *{隣|となり}*に コンビニが あります。", "en": "There's a convenience store next to the bank.", "pl": "Obok banku jest sklep całodobowy." } },
    { "id": "l04-migi", "japanese": "右", "kana": "みぎ", "en": "right (side)", "pl": "prawo; prawa strona", "type": "noun", "genkiLesson": 4, "tags": ["location"],
      "example": { "ja": "{郵便局|ゆうびんきょく}は {図書館|としょかん}の *{右|みぎ}*です。", "en": "The post office is to the right of the library.", "pl": "Poczta jest na prawo od biblioteki." } },
    { "id": "l04-hidari", "japanese": "左", "kana": "ひだり", "en": "left (side)", "pl": "lewo; lewa strona", "type": "noun", "genkiLesson": 4, "tags": ["location"],
      "example": { "ja": "ホテルの *{左|ひだり}*に {病院|びょういん}が あります。", "en": "There's a hospital to the left of the hotel.", "pl": "Na lewo od hotelu jest szpital." } },
    { "id": "l04-aida", "japanese": "間", "kana": "あいだ", "en": "between (AとBの間)", "pl": "między (A a B)", "type": "noun", "genkiLesson": 4, "tags": ["location"],
      "example": { "ja": "{駅|えき}と {大学|だいがく}の *{間|あいだ}*に スーパーが あります。", "en": "There's a supermarket between the station and the university.", "pl": "Między stacją a uniwersytetem jest supermarket." } },
    { "id": "l04-chikaku", "japanese": "近く", "kana": "ちかく", "en": "near; nearby; vicinity", "pl": "w pobliżu; niedaleko; okolica", "type": "noun", "genkiLesson": 4, "tags": ["location"],
      "example": { "ja": "この *{近く|ちかく}*に {銀行|ぎんこう}が ありますか。", "en": "Is there a bank near here?", "pl": "Czy jest tu w pobliżu bank?" } },
    { "id": "l04-getsuyoubi", "japanese": "月曜日", "kana": "げつようび", "en": "Monday", "pl": "poniedziałek", "type": "noun", "genkiLesson": 4, "tags": ["time", "days"],
      "example": { "ja": "*{月曜日|げつようび}*に {銀行|ぎんこう}へ {行きました|いきました}。", "en": "I went to the bank on Monday.", "pl": "W poniedziałek poszedłem do banku." } },
    { "id": "l04-kayoubi", "japanese": "火曜日", "kana": "かようび", "en": "Tuesday", "pl": "wtorek", "type": "noun", "genkiLesson": 4, "tags": ["time", "days"],
      "example": { "ja": "*{火曜日|かようび}*と {木曜日|もくようび}に アルバイトが あります。", "en": "I work part-time on Tuesdays and Thursdays.", "pl": "We wtorki i czwartki pracuję dorywczo." } },
    { "id": "l04-suiyoubi", "japanese": "水曜日", "kana": "すいようび", "en": "Wednesday", "pl": "środa", "type": "noun", "genkiLesson": 4, "tags": ["time", "days"],
      "example": { "ja": "*{水曜日|すいようび}*に {友達|ともだち}と {映画|えいが}を {見ました|みました}。", "en": "On Wednesday I saw a movie with a friend.", "pl": "W środę obejrzałem z kolegą film." } },
    { "id": "l04-mokuyoubi", "japanese": "木曜日", "kana": "もくようび", "en": "Thursday", "pl": "czwartek", "type": "noun", "genkiLesson": 4, "tags": ["time", "days"],
      "example": { "ja": "{昨日|きのう}は {水曜日|すいようび}じゃなかったです。 *{木曜日|もくようび}*でした。", "en": "Yesterday wasn't Wednesday. It was Thursday.", "pl": "Wczoraj nie była środa. Był czwartek." } },
    { "id": "l04-kinyoubi", "japanese": "金曜日", "kana": "きんようび", "en": "Friday", "pl": "piątek", "type": "noun", "genkiLesson": 4, "tags": ["time", "days"],
      "example": { "ja": "*{金曜日|きんようび}*の {夜|よる}、 {一緒に|いっしょに} {晩ご飯|ばんごはん}を {食べませんか|たべませんか}。", "en": "Would you like to have dinner together on Friday night?", "pl": "Może zjemy razem kolację w piątek wieczorem?" } },
    { "id": "l04-kinou", "japanese": "昨日", "kana": "きのう", "en": "yesterday", "pl": "wczoraj", "type": "noun", "genkiLesson": 4, "tags": ["time"],
      "example": { "ja": "*{昨日|きのう}*は {全然|ぜんぜん} {勉強しませんでした|べんきょうしませんでした}。", "en": "I didn't study at all yesterday.", "pl": "Wczoraj w ogóle się nie uczyłem." } },
    { "id": "l04-senshuu", "japanese": "先週", "kana": "せんしゅう", "en": "last week", "pl": "w zeszłym tygodniu; zeszły tydzień", "type": "noun", "genkiLesson": 4, "tags": ["time"],
      "example": { "ja": "*{先週|せんしゅう}*の {土曜日|どようび}に デートを しました。", "en": "I went on a date last Saturday.", "pl": "W zeszłą sobotę byłem na randce." } },
    { "id": "l04-konshuu", "japanese": "今週", "kana": "こんしゅう", "en": "this week", "pl": "w tym tygodniu; ten tydzień", "type": "noun", "genkiLesson": 4, "tags": ["time"],
      "example": { "ja": "*{今週|こんしゅう}*は {宿題|しゅくだい}が たくさん あります。", "en": "I have a lot of homework this week.", "pl": "W tym tygodniu mam dużo zadań domowych." } },
    { "id": "l04-raishuu", "japanese": "来週", "kana": "らいしゅう", "en": "next week", "pl": "w przyszłym tygodniu; przyszły tydzień", "type": "noun", "genkiLesson": 4, "tags": ["time"],
      "example": { "ja": "*{来週|らいしゅう}*の {土曜日|どようび}は どうですか。", "en": "How about Saturday next week?", "pl": "A może w przyszłą sobotę?" } },
    { "id": "l04-jikan-hours", "japanese": "～時間", "kana": "～じかん", "en": "… hours (duration)", "pl": "… godzin(y) (czas trwania)", "type": "counter", "genkiLesson": 4, "tags": ["time", "counters"],
      "example": { "ja": "{昨日|きのう} {三|さん}*{時間|じかん}* {勉強しました|べんきょうしました}。", "en": "Yesterday I studied for three hours.", "pl": "Wczoraj uczyłem się przez trzy godziny." } },
    { "id": "l04-gurai", "japanese": "～ぐらい", "kana": "～ぐらい", "alt": ["～くらい"], "en": "about; approximately (amount, length of time)", "pl": "około; mniej więcej (ilość, czas trwania)", "type": "suffix", "genkiLesson": 4, "tags": ["time"],
      "example": { "ja": "{毎日|まいにち} {一時間|いちじかん}*ぐらい* {日本語|にほんご}を {勉強します|べんきょうします}。", "en": "I study Japanese for about an hour every day.", "pl": "Codziennie uczę się japońskiego mniej więcej godzinę." } },
    { "id": "l04-takusan", "japanese": "たくさん", "kana": "たくさん", "en": "a lot; many; much", "pl": "dużo; wiele", "type": "adverb", "genkiLesson": 4, "tags": ["adverbs"],
      "example": { "ja": "{公園|こうえん}に {子供|こども}が *たくさん* いました。", "en": "There were lots of children in the park.", "pl": "W parku było dużo dzieci." } },
    { "id": "l04-au", "japanese": "会う", "kana": "あう", "en": "to meet; to see (a person) (～に会う)", "pl": "spotykać (się z kimś); widzieć się (z kimś)", "type": "verb-u", "genkiLesson": 4, "tags": ["daily-life", "people"],
      "example": { "ja": "{今朝|けさ} {駅|えき}で {田中|たなか}さんに *{会いました|あいました}*。", "en": "I ran into Ms. Tanaka at the station this morning.", "pl": "Dziś rano spotkałem panią Tanakę na stacji." } },
    { "id": "l04-kau", "japanese": "買う", "kana": "かう", "en": "to buy", "pl": "kupować", "type": "verb-u", "genkiLesson": 4, "tags": ["shopping"],
      "example": { "ja": "コンビニで {水|みず}を *{買いました|かいました}*。", "en": "I bought some water at the convenience store.", "pl": "Kupiłem wodę w sklepie całodobowym." } },
    { "id": "l04-kaku", "japanese": "書く", "kana": "かく", "en": "to write", "pl": "pisać", "type": "verb-u", "genkiLesson": 4, "tags": ["daily-life", "school"],
      "example": { "ja": "{日本語|にほんご}で {名前|なまえ}を *{書きました|かきました}*。", "en": "I wrote my name in Japanese.", "pl": "Napisałem swoje imię po japońsku." } },
    { "id": "l04-toru", "japanese": "撮る", "kana": "とる", "en": "to take (a photo) (写真を撮る)", "pl": "robić (zdjęcie)", "type": "verb-u", "genkiLesson": 4, "tags": ["hobbies"],
      "example": { "ja": "お{寺|てら}で {写真|しゃしん}を たくさん *{撮りました|とりました}*。", "en": "I took lots of photos at the temple.", "pl": "W świątyni zrobiłem dużo zdjęć." } },
    { "id": "l04-matsu", "japanese": "待つ", "kana": "まつ", "en": "to wait (for)", "pl": "czekać (na)", "type": "verb-u", "genkiLesson": 4, "tags": ["daily-life"],
      "example": { "ja": "{駅|えき}の {前|まえ}で {一時間|いちじかん} *{待ちました|まちました}*。", "en": "I waited for an hour in front of the station.", "pl": "Czekałem godzinę przed stacją." } },
    { "id": "l04-wakaru", "japanese": "分かる", "kana": "わかる", "en": "to understand; to know (～が分かる)", "pl": "rozumieć; wiedzieć", "type": "verb-u", "genkiLesson": 4, "tags": ["daily-life"],
      "example": { "ja": "{日本語|にほんご}が *{分かりますか|わかりますか}*。 —— はい、 ちょっと {分かります|わかります}。", "en": "Do you understand Japanese? — Yes, a little.", "pl": "Rozumiesz po japońsku? — Tak, trochę." } },
    { "id": "l04-arubaito", "japanese": "アルバイト", "kana": "アルバイト", "alt": ["バイト"], "en": "part-time job", "pl": "praca dorywcza", "type": "noun", "genkiLesson": 4, "tags": ["work"],
      "example": { "ja": "マリアさんは {喫茶店|きっさてん}で *アルバイト*を します。", "en": "Maria works part-time at a café.", "pl": "Maria dorabia w kawiarni." } },
    { "id": "l04-kaimono", "japanese": "買い物", "kana": "かいもの", "en": "shopping", "pl": "zakupy", "type": "noun", "genkiLesson": 4, "tags": ["shopping"],
      "example": { "ja": "{週末|しゅうまつ}に {友達|ともだち}と *{買い物|かいもの}*を しました。", "en": "I went shopping with a friend at the weekend.", "pl": "W weekend byłem z kolegą na zakupach." } },
    { "id": "l04-kurasu", "japanese": "クラス", "kana": "クラス", "en": "class (lesson; group of students)", "pl": "zajęcia; klasa (grupa)", "type": "noun", "genkiLesson": 4, "tags": ["school"],
      "example": { "ja": "{日本語|にほんご}の *クラス*に {留学生|りゅうがくせい}が たくさん います。", "en": "There are many international students in the Japanese class.", "pl": "Na zajęciach z japońskiego jest dużo studentów z zagranicy." } },
    { "id": "l04-inu", "japanese": "犬", "kana": "いぬ", "en": "dog", "pl": "pies", "type": "noun", "genkiLesson": 4, "tags": ["animals"],
