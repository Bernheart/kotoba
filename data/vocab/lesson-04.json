    { "id": "l04-neko", "japanese": "猫", "kana": "ねこ", "en": "cat", "pl": "kot", "type": "noun", "genkiLesson": 4, "tags": ["animals"],
      "example": { "ja": "*{猫|ねこ}*は {机|つくえ}の {下|した}に います。", "en": "The cat is under the desk.", "pl": "Kot jest pod biurkiem." } },
    { "id": "l04-kodomo", "japanese": "子供", "kana": "こども", "en": "child", "pl": "dziecko", "type": "noun", "genkiLesson": 4, "tags": ["people", "family"],
