    { "id": "l04-gohan", "japanese": "ご飯", "kana": "ごはん", "en": "cooked rice; meal", "pl": "ryż (gotowany); posiłek", "type": "noun", "genkiLesson": 4, "tags": ["food"],
      "example": { "ja": "{一緒に|いっしょに} *ご{飯|はん}*を {食べませんか|たべませんか}。", "en": "Shall we have a meal together?", "pl": "Może zjemy coś razem?" } },
    { "id": "l04-shashin", "japanese": "写真", "kana": "しゃしん", "en": "photo; picture", "pl": "zdjęcie; fotografia", "type": "noun", "genkiLesson": 4, "tags": ["things", "hobbies"],
      "example": { "ja": "これは {昨日|きのう}の デートの *{写真|しゃしん}*です。", "en": "This is a photo from yesterday's date.", "pl": "To zdjęcie z wczorajszej randki." } },
    { "id": "l04-byouin", "japanese": "病院", "kana": "びょういん", "en": "hospital; clinic", "pl": "szpital; przychodnia", "type": "noun", "genkiLesson": 4, "tags": ["places", "health"],
      "example": { "ja": "{先週|せんしゅう} *{病院|びょういん}*に {行きました|いきました}。", "en": "I went to the hospital last week.", "pl": "W zeszłym tygodniu poszedłem do szpitala." } },
    { "id": "l04-hoteru", "japanese": "ホテル", "kana": "ホテル", "en": "hotel", "pl": "hotel", "type": "noun", "genkiLesson": 4, "tags": ["places", "travel"],
      "example": { "ja": "あの *ホテル*の {中|なか}に レストランが あります。", "en": "There's a restaurant inside that hotel.", "pl": "W tamtym hotelu jest restauracja." } },
    { "id": "l04-basutei", "japanese": "バス停", "kana": "バスてい", "en": "bus stop", "pl": "przystanek autobusowy", "type": "noun", "genkiLesson": 4, "tags": ["places", "transport"],
      "example": { "ja": "*バス{停|てい}*は どこに ありますか。", "en": "Where is the bus stop?", "pl": "Gdzie jest przystanek autobusowy?" } },
    { "id": "l04-kouen", "japanese": "公園", "kana": "こうえん", "en": "park", "pl": "park", "type": "noun", "genkiLesson": 4, "tags": ["places", "nature"],
