    { "id": "l04-suupaa", "japanese": "スーパー", "kana": "スーパー", "en": "supermarket", "pl": "supermarket", "type": "noun", "genkiLesson": 4, "tags": ["places", "shopping"],
      "example": { "ja": "*スーパー*で {肉|にく}と {野菜|やさい}を {買いました|かいました}。", "en": "I bought meat and vegetables at the supermarket.", "pl": "W supermarkecie kupiłem mięso i warzywa." } },
    { "id": "l04-otera", "japanese": "お寺", "kana": "おてら", "en": "(Buddhist) temple", "pl": "świątynia (buddyjska)", "type": "noun", "genkiLesson": 4, "tags": ["places", "travel"],
      "example": { "ja": "{京都|きょうと}には *お{寺|てら}*が たくさん あります。", "en": "There are many temples in Kyoto.", "pl": "W Kioto jest wiele świątyń." } },
    { "id": "l04-machi", "japanese": "町", "kana": "まち", "en": "town; city", "pl": "miasto; miasteczko", "type": "noun", "genkiLesson": 4, "tags": ["places"],
      "example": { "ja": "この *{町|まち}*には {病院|びょういん}が ありません。", "en": "There's no hospital in this town.", "pl": "W tym mieście nie ma szpitala." } },
    { "id": "l04-hitoride", "japanese": "一人で", "kana": "ひとりで", "en": "alone; by oneself", "pl": "sam; samotnie; w pojedynkę", "type": "adverb", "genkiLesson": 4, "tags": ["adverbs"],
      "example": { "ja": "{昨日|きのう}は *{一人で|ひとりで}* {映画|えいが}を {見ました|みました}。", "en": "Yesterday I watched a movie by myself.", "pl": "Wczoraj sam obejrzałem film." } },
