    { "id": "l06-wasureru", "japanese": "忘れる", "kana": "わすれる", "en": "to forget; to leave (something) behind", "pl": "zapominać; zostawiać (coś gdzieś)", "type": "verb-ru", "genkiLesson": 6, "tags": ["daily-life", "school"],
