    { "id": "l06-hairu", "japanese": "入る", "kana": "はいる", "en": "to enter; to go in (～に入る); to take (a bath — お風呂に入る)", "pl": "wchodzić (do środka) (～に入る); brać (kąpiel — お風呂に入る)", "type": "verb-u", "genkiLesson": 6, "tags": ["house", "daily-life"],
