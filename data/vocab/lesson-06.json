    { "id": "l06-abiru", "japanese": "浴びる", "kana": "あびる", "en": "to take (a shower — シャワーを浴びる)", "pl": "brać (prysznic — シャワーを浴びる)", "type": "verb-ru", "genkiLesson": 6, "tags": ["daily-life"],
