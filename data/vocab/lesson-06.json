    { "id": "l06-miseru", "japanese": "見せる", "kana": "みせる", "en": "to show", "pl": "pokazywać", "type": "verb-ru", "genkiLesson": 6, "tags": ["requests"],
      "example": { "ja": "{写真|しゃしん}を *{見せて|みせて}*ください。", "en": "Please show me the photos.", "pl": "Proszę pokazać mi zdjęcia." } },

    { "id": "l06-asobu", "japanese": "遊ぶ", "kana": "あそぶ", "en": "to play; to hang out; to have a good time", "pl": "bawić się; spędzać czas (ze znajomymi)", "type": "verb-u", "genkiLesson": 6, "tags": ["daily-life", "hobbies"],
