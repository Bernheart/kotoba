    { "id": "l06-oriru", "japanese": "降りる", "kana": "おりる", "en": "to get off (a vehicle — ～を降りる)", "pl": "wysiadać (z pojazdu)", "type": "verb-ru", "genkiLesson": 6, "tags": ["transport"],
