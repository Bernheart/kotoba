    { "id": "l06-kaesu", "japanese": "返す", "kana": "かえす", "en": "to return (a thing); to give back", "pl": "oddawać; zwracać (coś)", "type": "verb-u", "genkiLesson": 6, "tags": ["things", "requests"],
