    { "id": "l06-kesu", "japanese": "消す", "kana": "けす", "en": "to turn off; to erase", "pl": "wyłączać; gasić (światło); wymazywać", "type": "verb-u", "genkiLesson": 6, "tags": ["house", "daily-life"],
