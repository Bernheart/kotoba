    { "id": "l06-oshieru", "japanese": "教える", "kana": "おしえる", "en": "to teach; to tell (information)", "pl": "uczyć (kogoś czegoś); podawać (informację)", "type": "verb-ru", "genkiLesson": 6, "tags": ["school", "requests"],
