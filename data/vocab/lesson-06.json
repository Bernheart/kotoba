    { "id": "l06-tsukeru", "japanese": "つける", "kana": "つける", "en": "to turn on (a light, TV)", "pl": "włączać (światło, telewizor)", "type": "verb-ru", "genkiLesson": 6, "tags": ["house", "requests"],
